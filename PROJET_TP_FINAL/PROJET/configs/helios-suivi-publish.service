# /etc/systemd/system/helios-suivi-publish.service — publication de etat.json (declenchee par le timer)
[Unit]
Description=Publication de l'etat du collecteur Helios (etat.json)
After=helios-collect.service

[Service]
Type=oneshot
User=helios-suivi
Group=helios-suivi
ExecStart=/usr/local/sbin/helios-suivi-publish.sh
# 2 = une autre instance tourne deja : ce n'est pas une panne
SuccessExitStatus=2

# Ne peut ecrire QUE dans www
ProtectSystem=strict
ReadWritePaths=/srv/helios/suivi/www
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
