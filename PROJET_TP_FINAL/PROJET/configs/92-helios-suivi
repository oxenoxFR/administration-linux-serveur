# /etc/sudoers.d/92-helios-suivi — delegation pour l'equipe « suivi » (lea)
# Chaque commande est ecrite avec TOUS ses arguments : sudo refuse alors toute option ajoutee.
# --no-pager est obligatoire : sinon systemctl/journalctl ouvrent « less » en root, d'ou on sort un shell (!sh).
# Pas de NOPASSWD : lea retape son mot de passe.
Cmnd_Alias SUIVI_SERVICE = /usr/bin/systemctl restart helios-suivi.service, \
                           /usr/bin/systemctl status --no-pager helios-suivi.service, \
                           /usr/bin/systemctl start helios-suivi-publish.service
Cmnd_Alias SUIVI_JOURNAL = /usr/bin/journalctl -u helios-suivi.service -n 100 --no-pager, \
                           /usr/bin/journalctl -u helios-suivi-publish.service -n 100 --no-pager

%suivi ALL=(root) SUIVI_SERVICE, SUIVI_JOURNAL
